# Copy to .env and choose a password. No default administrator password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# legacy: existing shared credentials; database: per-owner hashed credentials, no legacy fallback.
OWNER_AUTH_MODE=legacy
# One trading database is permanently bound to this store ID on first initialization.
STORE_ID=primary
STORE_NAME=기본 매장
# true requires a device-created customer session for all order/quote requests.
# false is only for the existing HTML prototype during migration.
KIOSK_AUTH_REQUIRED=true
SERVE_WEB=true
# Defaults to apps/backend/instance/kiosk.db (copied from data/seed.db once).
# SQLITE_DB_PATH=C:/SmartKiosk/Interactive-kiosk/apps/backend/instance/kiosk.db
# Browser origins only; native Flutter does not require CORS.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
